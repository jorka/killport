{
  "name": "killport",
  "displayName": "Killport",
  "description": "See every listening port and which process (and project) holds it, right next to your terminal. Kill it in one click. Also exposes an MCP server so AI agents can do the same.",
  "version": "0.1.0",
  "publisher": "JoroGeorgiev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorka/killport.git"
  },
  "bugs": {
    "url": "https://github.com/jorka/killport/issues"
  },
  "homepage": "https://github.com/jorka/killport#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "port",
    "kill",
    "kill port",
    "lsof",
    "EADDRINUSE",
    "address already in use",
    "process",
    "docker",
    "mcp",
    "dev server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:killport"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "killport",
          "title": "Killport",
          "icon": "$(plug)"
        }
      ]
    },
    "views": {
      "killport": [
        {
          "type": "webview",
          "id": "killport.portsView",
          "name": "Listening Ports",
          "icon": "$(plug)"
        }
      ]
    },
    "commands": [
      {
        "command": "killport.refresh",
        "title": "Refresh",
        "category": "Killport",
        "icon": "$(refresh)"
      },
      {
        "command": "killport.killPort",
        "title": "Kill Process on Port\u2026",
        "category": "Killport",
        "icon": "$(close)"
      },
      {
        "command": "killport.show",
        "title": "Show Listening Ports",
        "category": "Killport"
      },
      {
        "command": "killport.openSettings",
        "title": "Open Settings",
        "category": "Killport",
        "icon": "$(gear)"
      },
      {
        "command": "killport.editLabel",
        "title": "Label Port\u2026",
        "category": "Killport"
      },
      {
        "command": "killport.stopWorkspaceServers",
        "title": "Stop Servers Started in This Workspace",
        "category": "Killport",
        "icon": "$(debug-stop)"
      },
      {
        "command": "killport.openInBrowser",
        "title": "Open Port in Browser",
        "category": "Killport"
      },
      {
        "command": "killport.toggleWatch",
        "title": "Watch / Unwatch Port",
        "category": "Killport"
      },
      {
        "command": "killport.switchPort",
        "title": "Move Server to Another Port\u2026",
        "category": "Killport",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "killport.toggleHideApps",
        "title": "Toggle Hide Apps & System",
        "category": "Killport"
      },
      {
        "command": "killport.toggleWorkspaceOnly",
        "title": "Toggle This Workspace Only",
        "category": "Killport"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "killport.refresh",
          "when": "view == killport.portsView",
          "group": "navigation@2"
        },
        {
          "command": "killport.killPort",
          "when": "view == killport.portsView",
          "group": "navigation@1"
        },
        {
          "command": "killport.openSettings",
          "when": "view == killport.portsView",
          "group": "navigation@9"
        },
        {
          "command": "killport.stopWorkspaceServers",
          "when": "view == killport.portsView",
          "group": "1_workspace"
        }
      ],
      "commandPalette": [
        {
          "command": "killport.openInBrowser",
          "when": "false"
        },
        {
          "command": "killport.toggleWatch",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Killport",
      "properties": {
        "killport.hideAppsAndSystem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Hide ports held by desktop apps (inside a macOS `.app`: Discord, Chrome, VS Code's own helpers\u2026), OS services (`/System`, `/usr/libexec`, `C:\\\\Windows`) and editor/agent helpers (anything running from `~/.vscode/extensions`, e.g. Claude Code). Docker containers, and dev servers installed as apps (Postgres.app, Herd, Ollama\u2026), stay visible."
        },
        "killport.workspaceOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show servers started from the folder open in this window (Docker Compose containers count by their project folder)."
        },
        "killport.hideSystemPorts": {
          "type": "boolean",
          "default": false,
          "description": "Hide ports below 1024."
        },
        "killport.portRange": {
          "type": "string",
          "default": "",
          "markdownDescription": "Only show these ports, e.g. `3000-9999` or `3000-3999,5432,8080`. Empty shows all."
        },
        "killport.autoRefreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Seconds between automatic refreshes (0 turns it off). Only runs while the VS Code window is focused."
        },
        "killport.confirmBeforeKill": {
          "type": "boolean",
          "default": true,
          "description": "Ask before killing a process."
        },
        "killport.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the listening-port count in the status bar."
        },
        "killport.detectPortConflicts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Watch terminal output for **port already in use** errors (`EADDRINUSE`, Vite/Next \"Port 3000 is in use\", Go, Python, Rails, PHP, Spring, Docker\u2026) and offer to kill whatever holds the port. Needs VS Code 1.93+ with terminal shell integration (on by default)."
        },
        "killport.portLabels": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Your own names for ports, shown in the panel, e.g. `{ \"3000\": \"rezicard front\", \"55432\": \"rezicard db\" }`. Click the \u270e next to a port to edit."
        },
        "killport.stopServersOnClose": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When this VS Code window closes, stop the servers that were started from its workspace folder (dev servers, watchers\u2026), so they don't keep ports busy. Docker containers are left running."
        },
        "killport.openBrowserIn": {
          "type": "string",
          "enum": [
            "external",
            "simpleBrowser"
          ],
          "enumDescriptions": [
            "Your default web browser",
            "VS Code's built-in Simple Browser, in an editor tab"
          ],
          "default": "external",
          "description": "Where clicking a web server's port opens it."
        },
        "killport.watchPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [],
          "markdownDescription": "Ports you expect to be running, e.g. `[3000, 5432]`. They stay in the panel when down, the status bar warns while one is down, and you get a notification when one stops or starts. Click \u2606 on a row to add one."
        },
        "killport.notifyWatchedPorts": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a watched port stops or starts listening."
        },
        "killport.warnSharedPorts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when two programs listen on the same port, one on IPv4 and one on IPv6. The OS allows it, but `localhost:<port>` and `127.0.0.1:<port>` then reach different apps."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "killport.mcp",
        "label": "Killport"
      }
    ],
    "taskDefinitions": [
      {
        "type": "killport",
        "required": [
          "ports"
        ],
        "properties": {
          "ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "description": "Ports to free, e.g. [3000, 5173]."
          },
          "force": {
            "type": "boolean",
            "default": true,
            "description": "Kill hard if a process ignores the graceful stop (default true, since a task cannot ask)."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --minify && vsce package --no-dependencies",
    "test:integration": "node esbuild.mjs && node test/runTest.mjs"
  },
  "devDependencies": {
    "@killport/core": "0.1.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "mocha": "^11.7.5"
  },
  "icon": "images/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#1f2a44",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ]
}
